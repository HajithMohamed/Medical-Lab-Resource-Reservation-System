# ---- Dependencies ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js build output ----
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ---- Tests ----
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ---- Prisma generated client (made by `prisma generate`) ----
/src/generated/

# ---- Environment files ----
# Real values are never committed: .env.local, .env.supabase.local (Supabase password),
# .env.production.local and any other .env file. Only these documented, secret-free
# files are committed:
.env*
!.env.example
!.env.development
!.env.test
!.env.production.example

# ---- Secrets and certificates ----
*.pem
*.key

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ---- Hosting and tool folders ----
.vercel
supabase/.temp/
supabase/.branches/

# ---- Editors and operating systems ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
