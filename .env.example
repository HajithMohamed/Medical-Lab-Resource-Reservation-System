# =========================================================================
# Every environment variable this project uses. Nothing else is read.
# The app checks them when it starts (src/lib/env.ts) and stops with a
# clear message if one is missing or wrong.
#
# Which file is read (first match wins; real environment variables win
# over every file):
#   npm run dev, Prisma CLI, db:seed -> .env.development.local, .env.local, .env.development
#   tests (NODE_ENV=test)            -> .env.test.local, .env.test (.env.local is NOT read)
#   npm run build, npm start         -> .env.production.local, .env.local, .env.production
# Only .env.example, .env.development, .env.test and .env.production.example
# are committed. Never commit real secrets.
# =========================================================================

# PostgreSQL connection string. docker-compose.yml starts a matching local database.
DATABASE_URL="postgresql://lab:lab@localhost:5432/lab_reservations"

# Signs the sign-in cookie. At least 32 random characters. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Time zone of the lab network (IANA name). Times are entered and shown in it.
APP_TIME_ZONE="Asia/Colombo"

# ---- Used only by `npm run db:seed` ----
# First admin account (created once; skipped if the email already exists).
SEED_ADMIN_NAME="Lab Administrator"
SEED_ADMIN_EMAIL="admin@lab.example"
SEED_ADMIN_PASSWORD="replace-with-15-or-more-characters"
# "true" adds demo sites, resources, users and bookings. Never in production.
SEED_DEMO_DATA="false"
# Password of every demo user (15 or more characters).
SEED_DEMO_PASSWORD="replace-with-15-or-more-characters"

# ---- Email delivery (Resend: https://resend.com/onboarding) ----
# API Key from Resend dashboard (e.g. re_123456789)
RESEND_API_KEY="replace-with-your-resend-api-key"
# From address. For onboarding / unverified domains, Resend requires onboarding@resend.dev
EMAIL_FROM="BenchBook <onboarding@resend.dev>"
# Base URL for email action links (change password, sign in)
APP_BASE_URL="http://localhost:3000"

# ---- Daily Cron Secret (Authorization: Bearer <CRON_SECRET>) ----
CRON_SECRET="682df679de8ae08d25b4d3bba914bddab37b5872d40ff1b7bcdb1374452f90af"

