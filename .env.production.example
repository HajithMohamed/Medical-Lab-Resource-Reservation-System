# Production template. Do NOT put real values in this file.
# On a server or hosting platform, set these as real environment variables.
# To try a production build on your machine, copy this file to
# .env.production.local (never committed) and fill it in.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
SESSION_SECRET=""
APP_TIME_ZONE="Asia/Colombo"
# Used once by `npm run db:seed` to create the first admin, who must change
# the password at the first sign-in.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_DEMO_DATA="false"
